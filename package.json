{
  "name": "hookmint",
  "version": "0.13.1",
  "private": true,
  "type": "module",
  "description": "Hookmint: MCP server that turns prompts into video ads",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p render/tsconfig.json --noEmit",
    "test": "tsx tests/smoke.ts && tsx tests/foundations.ts && tsx tests/brand.ts && tsx tests/variants.ts && tsx tests/claude.ts && tsx tests/net.ts && tsx tests/limits.ts && tsx tests/hardening.ts && tsx tests/providers.ts && tsx tests/oauth.ts && tsx tests/contract/contract.ts",
    "test:update-snapshot": "UPDATE_SNAPSHOT=1 tsx tests/contract/contract.ts",
    "test:live": "tsx --env-file-if-exists=.env scripts/live-check.ts",
    "test:render": "tsx tests/render.ts",
    "test:all": "npm test && npm run test:render",
    "lint": "eslint .",
    "start": "node dist/http.js",
    "audit": "tsx scripts/audit-gate.ts",
    "keys:new": "tsx scripts/new-key.ts",
    "test:live:media": "tsx --env-file-if-exists=.env scripts/live-media.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "test:pg": "tsx --env-file-if-exists=.env scripts/test-pg.ts",
    "credits:grant": "tsx --env-file-if-exists=.env scripts/grant-credits.ts",
    "oauth:inspect": "tsx --env-file-if-exists=.env scripts/inspect-token.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "pngjs": "7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
