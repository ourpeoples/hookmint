  {
    "name": "get_brand_kit",
    "description": "Get a brand kit's details, including logo_status: 'none' (no logo given), 'pending' (still downloading), 'ready', 'failed' (logo_error says why) or 'unavailable' (this server cannot download logos). Read-only.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "brand_kit_id": {
          "type": "string",
          "description": "From create_brand_kit"
        }
      },
