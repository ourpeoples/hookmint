                "type": "boolean"
              },
              "unlabelled_ads": {
                "type": "number"
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string"
                    },
                    "ads": {
                      "type": "number"
                    },
                    "impressions": {
                      "type": "number"
                    },
                    "clicks": {
                      "type": "number"
                    },
                    "conversions": {
                      "type": "number"
                    },
                    "shortfall": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "value",
                    "ads",
                    "impressions",
                    "clicks",
                    "conversions",
                    "shortfall"
                  ],
                  "additionalProperties": {}
                }
              },
              "leads": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "metric": {
                      "type": "string",
                      "enum": [
                        "ctr",
                        "cvr"
                      ]
                    },
                    "leading_value": {
                      "type": "string"
                    },
                    "beaten_values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "usable_for_generation": {
                      "type": "boolean",
                      "const": false
                    },
                    "adjusted_p": {
                      "type": "number"
                    },
                    "statement": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "metric",
                    "leading_value",
                    "beaten_values",
                    "usable_for_generation",
                    "adjusted_p",
                    "statement"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "dimension",
              "within",
              "evidence",
              "comparable",
              "unlabelled_ads",
              "warnings",
              "rows",
              "leads"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "schema_version",
        "warnings",
        "brand_kit_id",
        "method_version",
        "status",
        "groups_tested",
        "groups_with_a_clear_winner",
        "insights",
        "message",
        "breakdown_method_version",
        "breakdown_message",
        "breakdowns"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_performance",
    "description": "How the variants of one test are doing: for click-through and conversion rate, each variant's rate with a 95% interval, the lift over the base with its interval, and a verdict. A verdict is 'winner' only when one variant beats every other after correcting for the number of comparisons AND every variant has enough data; otherwise it says 'no_clear_winner' or 'insufficient_data' and how much more data each needs. Only days where every variant has numbers are compared. Results are labelled causal or observational. Pass variant_group_id for one test, or brand_kit_id for a summary of every test of a brand.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "variant_group_id": {
          "type": "string"
        },
        "brand_kit_id": {
          "type": "string"
        },
        "from": {
          "description": "Only use days on or after this date (YYYY-MM-DD)",
          "type": "string"
        },
        "to": {
          "description": "Only use days on or before this date (YYYY-MM-DD)",
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "get_storyboard",
    "description": "Get a free preview of the ad's timing and captions, scene by scene, before any paid generation. Read-only.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "link_ad",
    "description": "After you launch a finished ad on an ad platform, tell Hookmint which live ad it is (platform and the platform's ad id) and HOW it was launched: 'platform_experiment' (the platform's own split test) or 'same_ad_set' (variants side by side in one ad set) allow a fair comparison; 'separate' (different ad sets or budgets) is labelled observational because audiences and timing may differ. Needed before record_performance. The ad must be completed.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "The finished ad"
        },
        "platform": {
          "type": "string",
          "enum": [
            "meta",
            "tiktok",
            "google",
            "youtube",
            "linkedin",
            "other"
          ]
        },
        "platform_ad_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "The ad's id on that platform"
        },
        "launch_mode": {
          "type": "string",
          "enum": [
            "platform_experiment",
            "same_ad_set",
            "separate"
          ]
        },
        "aspect_ratio": {
          "description": "Which render this live ad uses",
          "type": "string",
          "enum": [
            "9:16",
            "1:1",
            "16:9"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "description": "Unique string for this request, e.g. a UUID. Repeating a call with the same key and inputs returns the original result and spends nothing extra."
        }
      },
      "required": [
        "job_id",
        "platform",
        "platform_ad_id",
        "launch_mode",
        "idempotency_key"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "list_ads",
    "description": "List recent ads and their statuses, newest first.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "plan_test",
    "description": "Before launching variants: how many impressions each variant needs to reliably notice a difference of a given size, so an underpowered test is visible up front. Pure arithmetic; reads no data and spends nothing. Give the rate you expect for the base (e.g. 0.02 for a 2% click-through), the smallest relative improvement worth detecting (0.2 = 20% better), and how many variants including the base.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "baseline_rate": {
          "type": "number",
          "description": "Expected rate for the base ad, between 0 and 1"
        },
        "relative_lift": {
          "type": "number",
          "description": "Smallest improvement worth finding, as a fraction of the base rate (0.2 = 20% better)"
        },
        "variants": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "Total variants including the base, 2 to 11"
        },
        "power": {
          "description": "Chance of finding a real difference of that size. Default 0.8",
          "type": "number"
        },
        "expected_daily_impressions_per_variant": {
          "description": "To get an estimate in days",
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "baseline_rate",
        "relative_lift",
        "variants"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "record_performance",
    "description": "Record daily results (impressions, clicks, conversions, spend) for a linked ad, up to 100 days per call, copied from the ad platform. Send one row per day. To correct a day, send it again: the old row is kept and the newest is used. All variants of a test must be measured the same way (same currency and attribution window) to be compared, so set attribution_window to how the platform counts conversions, e.g. '7d_click'.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "link_id": {
          "type": "string",
          "description": "From link_ad"
        },
        "currency": {
          "type": "string",
          "description": "Three-letter code, e.g. USD"
        },
        "timezone": {
          "description": "The ad account's time zone, e.g. America/New_York. Default UTC",
          "type": "string"
        },
        "attribution_window": {
          "description": "How the platform counts conversions, e.g. 7d_click. Default 'unspecified'",
          "type": "string"
        },
        "rows": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "impressions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000000
              },
              "clicks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000000
              },
              "conversions": {
                "default": 0,
                "type": "integer",
                "minimum": 0,
                "maximum": 10000000000
              },
              "spend": {
                "default": 0,
                "type": "number",
                "minimum": 0,
                "maximum": 1000000000
              }
            },
            "required": [
              "date",
              "impressions",
              "clicks"
            ]
          },
          "description": "One entry per day: date (YYYY-MM-DD), impressions, clicks, conversions, spend"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "description": "Unique string for this request, e.g. a UUID. Repeating a call with the same key and inputs returns the original result and spends nothing extra."
        }
      },
      "required": [
        "link_id",
        "currency",
        "rows",
        "idempotency_key"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "regenerate_scene",
    "description": "Re-create the visual and voiceover for one scene using an instruction (e.g. 'show a family instead'). SPENDS CREDITS. Without confirm=true it only returns the estimate. To run it, pass confirm=true and max_credits. Only works while status is 'awaiting_approval'; the job returns to that status when done. Each ad allows a limited number of regenerations.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string"
        },
        "scene_id": {
          "type": "string"
        },
        "instruction": {
          "type": "string",
          "minLength": 3,
          "description": "What to change about this scene"
        },
        "confirm": {
          "default": false,
          "description": "Must be true to spend credits",
          "type": "boolean"
        },
        "max_credits": {
          "description": "Refuse if the estimate is higher than this",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "description": "Unique string for this request, e.g. a UUID. Repeating a call with the same key and inputs returns the original result and spends nothing extra."
        }
      },
      "required": [
        "job_id",
        "scene_id",
        "instruction",
        "idempotency_key"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "set_brand_rules",
    "description": "Replace a brand kit's rules. Rule types: banned_phrase, regex, forbidden_claim and required_disclaimer are checked deterministically; semantic rules are plain-language instructions checked by a model (advisory only). Each call saves a new rule-set version. forbidden_claim and required_disclaimer block approval by default. Examples (tone, past winners) guide generation and never block.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "brand_kit_id": {
          "type": "string",
          "description": "From create_brand_kit"
        },
        "rules": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "banned_phrase",
                  "regex",
                  "required_disclaimer",
                  "forbidden_claim",
                  "semantic"
                ]
              },
              "pattern": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "description": "Phrase, regex, disclaimer text, or (for semantic rules) a plain-language instruction"
              },
              "severity": {
                "description": "Defaults: banned_phrase warn, regex warn, forbidden_claim block, required_disclaimer block, semantic warn",
                "type": "string",
                "enum": [
                  "info",
                  "warn",
                  "block"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "type",
              "pattern"
            ]
          }
        },
        "examples": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "tone",
                  "past_winner"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "required": [
              "kind",
              "text"
            ]
          }
        }
      },
      "required": [
        "brand_kit_id",
        "rules"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "update_script",
    "description": "Edit the hook, call to action, or individual scenes of the script. Only works while status is 'awaiting_approval'. Free. Total scene duration must stay within 1 second of the requested ad length. Each edit creates a new plan version.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string"
        },
        "hook": {
          "type": "string"
        },
        "cta_text": {
          "type": "string"
        },
        "scenes": {
          "description": "Only the scenes you want to change",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scene_id": {
                "type": "string"
              },
              "voiceover": {
                "type": "string"
              },
              "on_screen_text": {
                "type": "string"
              },
              "visual_prompt": {
                "type": "string"
              },
              "duration_s": {
                "type": "number",
                "minimum": 1,
                "maximum": 10
              }
            },
            "required": [
              "scene_id"
            ]
          }
        }
      },
      "required": [
        "job_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  }
]
