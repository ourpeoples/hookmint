[
  {
    "name": "approve_and_render",
    "description": "Approve the current script and start paid generation and the final render for every requested aspect ratio. SPENDS CREDITS: pass max_credits (use the number from estimate_cost); the call is refused if the estimate is higher. Refused with blocked_by_rule if check_ad shows blocking findings, unless override_reason is given. Only works while status is 'awaiting_approval'. Poll get_ad_status until 'completed' to get the video URLs.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string"
        },
        "max_credits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Maximum credits you allow this to cost"
        },
        "override_reason": {
          "description": "Only if check_ad shows 'block' findings you accept. Recorded in the audit log.",
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "description": "Unique string for this request, e.g. a UUID. Repeating a call with the same key and inputs returns the original result and spends nothing extra."
        }
      },
      "required": [
        "job_id",
        "max_credits",
        "idempotency_key"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "cancel_ad",
    "description": "Cancel a job that has not finished. Credits held for stages that have not run are released. Safe to repeat.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "check_ad",
    "description": "Check the ad's current script against its brand kit's rules and return findings (severity, rule, quoted text, suggested fix). Free and read-only. Rules with type \"semantic\" are checked by a model in the background: semantic_status is \"pending\" until it finishes, \"off\" if no model is configured, \"unavailable\" if it failed. Findings are advisory, not legal advice. A 'block' finding stops approve_and_render unless an override_reason is given.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string"
        }
      },
      "required": [
        "job_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "compare_variants",
    "description": "Free, read-only. Shows an ad and all its variants side by side as text before anything is rendered: each one's hook and hook type, platform, the first scene's words with the estimated voice time against the scene length, its brand-check status and what it would cost to render. Use it to pick which hooks are worth paying to render. Give job_id (the base or any variant) or variant_group_id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job_id": {
          "description": "The base ad or any of its variants",
          "type": "string"
        },
        "variant_group_id": {
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "create_ad",
    "description": "Start a new video ad from a text prompt. Writes the script only (no paid generation) and returns a job_id. Next: poll get_ad_status until status is 'awaiting_approval', review the plan, call estimate_cost, optionally edit the script, then call approve_and_render.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 10,
          "description": "What the ad is for: product, audience, offer, desired feel"
        },
        "brand_kit_id": {
          "description": "From create_brand_kit",
          "type": "string"
        },
        "duration_s": {
          "default": 15,
          "description": "Ad length in seconds",
          "type": "integer",
          "minimum": 6,
          "maximum": 60
        },
        "aspect_ratios": {
          "default": [
            "9:16"
          ],
          "description": "Output formats to render",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "9:16",
              "1:1",
              "16:9"
            ]
          }
        },
        "platform": {
          "description": "Where the ad will run (tiktok, meta or youtube). The script opens the way that platform needs: hook inside its first seconds, text on screen where ads play without sound, and a length it allows",
          "type": "string",
          "enum": [
            "tiktok",
            "meta",
            "youtube"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "description": "Unique string for this request, e.g. a UUID. Repeating a call with the same key and inputs returns the original result and spends nothing extra."
        }
      },
      "required": [
        "prompt",
        "idempotency_key"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "create_brand_kit",
    "description": "Save a reusable brand kit (logo, colors, font, tone). Returns brand_kit_id to pass to create_ad. Call this once per brand, before create_ad.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Brand or company name"
        },
        "logo_url": {
          "description": "Public https URL of a PNG, JPEG or WebP logo (SVG is not accepted). It is downloaded in the background; check logo_status with get_brand_kit",
          "type": "string",
          "format": "uri"
        },
        "colors": {
          "default": [],
          "description": "Brand colors as hex codes, primary first",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "font": {
          "description": "Font family name",
          "type": "string"
        },
        "tone": {
          "description": "Voice and tone, e.g. 'friendly, trustworthy'",
          "type": "string"
        },
        "distinctive_assets": {
          "description": "Other things people recognise the brand by: a slogan, character, mascot or pack shot (type + value). The logo and primary colour already count. Ads are checked for at least three assets, two of them visible in the first three seconds",
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "logo",
                  "color",
                  "slogan",
                  "character",
                  "mascot",
                  "pack_shot"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "type",
              "value"
            ]
          }
        }
      },
      "required": [
        "name"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "create_variants",
    "description": "Create 1 to 10 alternative versions of an ad that differ from it in exactly one thing: hook, hook_type, angle, offer, cta or visual_style. A hook_type test writes the same ad with a different kind of opening (identity, product, pattern_interrupt, trend, result_first): the server gives each variant its own type and records it, so what is learned is about the kind of hook and carries over to other ads. Every variant is checked by a deterministic diff against the base ad and rejected if it changes anything else, so results from a later test can be attributed to that one variable. Returns each variant's job_id, the computed diff, and its brand-rule check. Free (text only); the variants then go through the normal estimate_cost, check_ad and approve_and_render steps. Works on an ad that is 'awaiting_approval' or 'completed'. One variant group tests one variable.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": "string",
          "description": "The base ad"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "How many variants to create (a base ad can have at most 10 in total; hook_type has only four unused types per base)"
        },
        "tested_variable": {
          "type": "string",
          "enum": [
            "hook",
            "angle",
            "offer",
            "cta",
            "visual_style",
            "hook_type"
          ],
          "description": "The one thing that should differ. hook_type tests kinds of opening; hook tests wording of one opening"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128,
          "description": "Unique string for this request, e.g. a UUID. Repeating a call with the same key and inputs returns the original result and spends nothing extra."
        }
      },
      "required": [
        "job_id",
        "count",
        "tested_variable",
        "idempotency_key"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  {
    "name": "estimate_cost",
    "description": "Show what approve_and_render would cost in credits, broken down by stage, plus your available balance. Free and read-only. Call before approve_and_render and pass the number as max_credits.",
