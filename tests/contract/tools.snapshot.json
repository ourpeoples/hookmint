  {
    "name": "get_insights",
    "description": "What a brand's finished tests have shown: plain statements such as which hook beat which, with the rates, the size of the lift with its interval, the corrected p-value and the sample size. A test with no clear winner produces nothing, and the answer says 'insufficient_data' when no test can conclude yet. Each statement is one test on one audience: it suggests, and does not prove, that an idea works elsewhere. The answer also has `breakdowns`: patterns across ALL of the brand's ads by platform and by hook type (and hook type inside each platform), with rates, intervals and, when one group clearly beats the rest, a lead. Those are observational, not controlled: they say what to test next (the lead names the test) and never steer script generation.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "brand_kit_id": {
          "type": "string"
        }
      },
      "required": [
        "brand_kit_id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brand_kit_id": {
          "type": "string"
        },
        "method_version": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "insufficient_data"
          ]
        },
        "groups_tested": {
          "type": "number"
        },
        "groups_with_a_clear_winner": {
          "type": "number"
        },
        "insights": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "tested_variable": {
                "type": "string"
              },
              "metric": {
                "type": "string",
                "enum": [
                  "ctr",
                  "cvr"
                ]
              },
              "evidence": {
                "type": "string",
                "enum": [
                  "causal",
                  "observational"
                ]
              },
              "usable_for_generation": {
                "type": "boolean"
              },
              "winning_value": {
                "type": "string"
              },
              "beaten_values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lift_vs_runner_up": {
                "type": "object",
                "properties": {
                  "ratio": {
                    "type": "number"
                  },
                  "interval": {
                    "type": "object",
                    "properties": {
                      "low": {
                        "type": "number"
                      },
                      "high": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "low",
                      "high"
                    ],
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "ratio",
                  "interval"
                ],
                "additionalProperties": {}
              },
              "adjusted_p": {
                "type": "number"
              },
              "sample_size": {
                "type": "object",
                "properties": {
                  "impressions_per_variant_min": {
                    "type": "number"
                  },
                  "clicks_per_variant_min": {
                    "type": "number"
                  }
                },
                "required": [
                  "impressions_per_variant_min",
                  "clicks_per_variant_min"
                ],
                "additionalProperties": {}
              },
              "metric_definition": {
                "type": "object",
                "properties": {
                  "metric": {
                    "type": "string"
                  },
                  "formula": {
                    "type": "string"
                  }
                },
                "required": [
                  "metric",
                  "formula"
                ],
                "additionalProperties": {}
              },
              "statement": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "tested_variable",
              "metric",
              "evidence",
              "usable_for_generation",
              "winning_value",
              "beaten_values",
              "lift_vs_runner_up",
              "adjusted_p",
              "sample_size",
              "metric_definition",
              "statement"
            ],
            "additionalProperties": {}
          }
        },
        "message": {
          "type": "string"
        },
        "breakdown_method_version": {
          "type": "string"
        },
        "breakdown_message": {
          "type": "string"
        },
